# Prefer Conta e configurações > Conexões de mercado in the desktop app.
# Optional first-launch environment configuration; .env is NOT auto-loaded.
# Saved account settings take precedence over these environment variables.
MARKET_DATA_PROVIDER=disabled
# Other values: brapi, twelve, combined
TWELVE_DATA_API_KEY=
BRAPI_API_KEY=
# Logs status/timing only, never payloads or keys.
MARKET_DATA_DEBUG=0
